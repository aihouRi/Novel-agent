# Test environment example
# IMPORTANT: database name must include `_test`
# and INTEGRATION_TEST must be 1 before running integration tests.
PORT=8080
MYSQL_DSN=novel:novel@tcp(127.0.0.1:3306)/novel_agent_test?parseTime=true&charset=utf8mb4,utf8
JWT_SECRET=test-secret
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
INTEGRATION_TEST=1
