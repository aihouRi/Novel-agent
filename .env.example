# Novel Agent environment template
# Copy this file to `.env.dev` or `.env.test` and adjust values.

# Shared
PORT=8080
JWT_SECRET=change-me
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Database (override per environment)
MYSQL_DSN=novel:novel@tcp(127.0.0.1:3306)/novel_agent?parseTime=true&charset=utf8mb4,utf8

# Integration test gate (set 1 only in test env when needed)
INTEGRATION_TEST=0
